rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function owner(){ return signedIn() && request.auth.token.owner == true; }
  match /users/{uid} {
   allow read: if signedIn() && (request.auth.uid == uid || owner());
   allow create: if signedIn() && request.auth.uid == uid
    && !request.resource.data.keys().hasAny(['owner','role','isAdmin','subscriptionStatus','subscriptionPlan','subscriptionExpiresAt']);
   allow update: if signedIn() && request.auth.uid == uid
    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner','role','isAdmin','subscriptionStatus','subscriptionPlan','subscriptionExpiresAt']);
   allow delete: if owner();
  }
  match /payments/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || owner()); allow write: if false; }
  match /subscriptions/{id} { allow read: if signedIn() && (resource.data.uid == request.auth.uid || owner()); allow write: if false; }
  match /adminLogs/{id} { allow read: if owner(); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}